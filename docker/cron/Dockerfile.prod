# docker/cron/Dockerfile.prod
FROM php:8.3-cli

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer \
    COMPOSER_CACHE_DIR=/tmp/composer-cache

# Systempakete inkl. netcat UND cron installieren
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    ca-certificates \
    curl \
    libzip-dev \
    libldap2-dev \
    libonig-dev \
    libxml2-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libicu-dev \
    netcat-traditional \
    cron \
    && rm -rf /var/lib/apt/lists/*

# PHP-Extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install \
        pdo_mysql \
        intl \
        mbstring \
        zip \
        ldap \
        gd

# Arbeitsverzeichnis
WORKDIR /var/www/html

# Composer global installieren (früh, damit Cache greift)
RUN curl -fsSL https://getcomposer.org/installer -o /tmp/composer-setup.php \
 && php /tmp/composer-setup.php --install-dir=/usr/local/bin --filename=composer \
 && rm -f /tmp/composer-setup.php

# NUR Composer-Metadaten kopieren (damit composer install cached bleibt)
COPY projekt/composer.json /var/www/html/composer.json
COPY projekt/composer.lock /var/www/html/composer.lock

# Composer im Image ausführen (ohne dev-Abhängigkeiten)
RUN --mount=type=cache,target=/tmp/composer-cache \
    composer install --no-dev --prefer-dist --no-interaction --no-progress \
 && composer dump-autoload -o --no-interaction

# Restlichen App-Code kopieren (nach composer install für besseres Caching)
COPY projekt/ /var/www/html/

# Cron-Skripte
COPY docker/cron/crontab /etc/crontabs/root
COPY docker/cron/start-cron.sh /usr/local/bin/start-cron.sh

RUN chmod +x /usr/local/bin/start-cron.sh \
    && ln -sf /usr/sbin/cron /usr/sbin/crond

CMD ["/usr/local/bin/start-cron.sh"]
